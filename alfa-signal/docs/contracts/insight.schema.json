    },
    "next_steps": {
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "minItems": 1,
      "title": "Next Steps",
      "type": "array"
    },
    "unknowns": {
      "description": "Каких данных не хватает для более точного вывода",
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "decision_question": {
      "description": "Главный вопрос, который стоит решить руководителю",
      "minLength": 1,
      "title": "Decision Question",
      "type": "string"
    },
    "insight_id": {
      "minLength": 1,
      "title": "Insight Id",
      "type": "string"
    },
    "company_id": {
      "minLength": 1,
      "title": "Company Id",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
