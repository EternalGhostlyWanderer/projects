  "additionalProperties": false,
  "description": "Полный инсайт, который backend отдаёт frontend.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "enum": [
        "risk",
        "opportunity",
        "mixed"
      ],
      "title": "Kind",
      "type": "string"
    },
    "relevance": {
      "$ref": "#/$defs/Relevance"
    },
    "event_summary": {
      "description": "Что произошло: только факты из новости с basis=FACT",
