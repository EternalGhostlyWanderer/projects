{
  "$defs": {
    "BankView": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "found",
            "not_found"
          ],
          "title": "Status",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "BankView",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "basis": {
          "description": "FACT — подтверждено новостью или данными компании; BANK_ANALYSIS — тезис из материала Альфа-Банка; AI_INFERENCE — вывод модели; HYPOTHESIS — требует проверки",
          "enum": [
            "FACT",
            "BANK_ANALYSIS",
            "AI_INFERENCE",
            "HYPOTHESIS"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence_ids": {
          "description": "id из переданного списка evidence; обязательны для FACT и BANK_ANALYSIS",
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "text",
        "basis",
        "confidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Единица доказательства. Собирается кодом, а не моделью.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "FACT",
            "BANK_ANALYSIS",
            "AI_INFERENCE",
            "HYPOTHESIS"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "news",
            "company_data",
            "bank_research",
            "model"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "event_id, поле CSV или chunk_id документа банка",
          "title": "Source Id"
        },
        "source_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Title"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Date"
        },
        "source_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page"
        }
      },
      "required": [
        "id",
        "type",
        "text",
        "source_kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "NextStep": {
      "additionalProperties": false,
