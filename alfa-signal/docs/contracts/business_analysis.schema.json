{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alfa-signal.local/contracts/business-analysis.schema.json",
  "title": "BusinessAnalysis",
  "description": "Structured business impact analysis returned by the LLM to the backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_summary",
    "relevance",
    "impact_mechanisms",
    "risks",
    "opportunities",
    "unknowns",
    "next_steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_summary": {
      "type": "string",
      "minLength": 1
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "reasons"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "impact_mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "effect", "direction", "confidence"],
        "properties": {
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": ["positive", "negative", "mixed", "uncertain"]
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "priority"],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "severity", "confidence"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "potential", "confidence"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "potential": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
