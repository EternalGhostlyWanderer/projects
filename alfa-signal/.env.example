# Скопируйте этот файл в .env перед запуском Docker Compose.
# Секреты из .env не коммитятся.

FRONTEND_PORT=8080
BACKEND_PORT=8000

# По умолчанию Compose использует синтетические данные из репозитория.
COMPANIES_CSV=data/synthetic/companies.csv
PAYMENTS_CSV=data/synthetic/payments.csv
PEOPLE_CSV=data/synthetic/people.csv
SEED_SYNTHETIC_DATA=1
DEMO_EVENTS_FILE=data/synthetic/news.json
VITE_COMPANY_IDS=SYN_001,SYN_002,SYN_003,SYN_004,SYN_005,SYN_006
VITE_USE_DEMO=0
# 1 — экран входа: сотрудники одной компании с разными ролями (demo, buh, owner; пароль alfa-signal).
VITE_DEMO_AUTH=1
# 1 — backend принимает только подписанные demo-сессии для защищённых API-вызовов.
DEMO_AUTH_REQUIRED=1
DEMO_AUTH_SECRET=change-this-to-a-random-secret

# Без ключа доступны лента, компании и keyword-классификация; AI-анализ вернёт 503.
# Бесплатные провайдеры (подробно — docs/free-llm-providers.md):
#   openrouter — ключ на openrouter.ai/keys, модели с суффиксом :free (50 запросов/день без пополнения)
#   groq       — ключ на console.groq.com/keys
#   gemini     — ключ на aistudio.google.com/apikey
#   mistral    — ключ на console.mistral.ai (бесплатный план Experiment)
#   ollama     — локальная модель, ключ не нужен; из Docker: LLM_BASE_URL=http://host.docker.internal:11434/v1
#   hackathon  — шлюз организаторов (ключ истёк)
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Пусто — адрес, модель и способ отключения рассуждений берутся из пресета LLM_PROVIDER.
LLM_BASE_URL=
LLM_MODEL=
LLM_MODEL_EXTRACT=
LLM_MODEL_ANALYZE=
LLM_MODEL_VERIFY=
LLM_THINK_STYLE=
# Запасные нейросети по порядку: провайдер[:модель] через запятую; ключи — <ПРОВАЙДЕР>_API_KEY.
LLM_FALLBACKS=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Для OpenRouter без пополнения баланса держите лимит ниже 50.
LLM_DAILY_REQUEST_LIMIT=45
LLM_DAILY_COST_LIMIT=

NEWS_RSS_URLS=https://www.cbr.ru/rss/RssPress,https://www.cbr.ru/rss/eventrss,https://www.kommersant.ru/RSS/section-economics.xml,https://www.vedomosti.ru/rss/rubric/economics,https://rssexport.rbc.ru/rbcnews/news/30/full.rss,https://www.interfax.ru/rss.asp,https://tass.ru/rss/v2.xml,https://www.kommersant.ru/RSS/section-business.xml
# 1 — сохранять и публикации без каналов влияния на бизнес (политика, спорт); по умолчанию отсеиваются
NEWS_KEEP_OFFTOPIC=0
# Иностранные издания на английском (docs/news-collection.md): пусто — ленты по умолчанию, «-» — выключить.
# Заголовки и анонсы переводятся на русский (нужен ключ LLM), до NEWS_TRANSLATE_BATCHES запросов за сбор.
NEWS_RSS_URLS_FOREIGN=
NEWS_TRANSLATE_BATCHES=4
# 1 — агент загружает полный текст статьи, если в ленте только анонс.
NEWS_FETCH_FULL_TEXT=1
# Официальные источники с открытым API (без ключей): cbr — ставка и курсы Банка России, moex — новости Мосбиржи (ISS)
NEWS_OFFICIAL_SOURCES=cbr,moex
# Порог движения официального курса за день, %, после которого появляется событие
CBR_FX_ALERT_PCT=1.0
# 0 — агент не обращается к данным ЦБ (get_official_rates)
CBR_DATA_ENABLED=1
CORS_ORIGINS=http://localhost:8080
