# Скопируйте в frontend/.env.local и при необходимости измените.
# 1 — работать на демо-данных без backend (как было раньше).
VITE_USE_DEMO=0
# Компании в выпадающем списке (SYNTHETIC_U через запятую). Подобрать из реальных данных:
# python backend/scripts/pick_demo_companies.py
VITE_COMPANY_IDS=SYN_001,SYN_002,SYN_003,SYN_004,SYN_005,SYN_006
# Адрес backend, если фронтенд открыт не через dev-сервер Vite (иначе пусто — работает прокси /api).
VITE_API_URL=
# Демо-вход (вебинар, вопрос 63): 1 — перед лентой экран входа. Логины задаются в backend DEMO_USERS
# (по умолчанию demo / alfa-signal).
VITE_DEMO_AUTH=0
