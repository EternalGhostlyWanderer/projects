# Секреты
.env
**/.env

# Виртуальные окружения Python
.venv/
**/.venv/

# Скачанные библиотеки
**/wheelhouse/

# Временные файлы Python
__pycache__/
**/__pycache__/
*.py[cod]

# Настройки IDE
.idea/

# Данные организаторов: храним локально
data/*
# Синтетические тестовые данные храним в Git (нужны жюри для сквозного сценария)
!data/synthetic/
# Снимок демо по синтетическим компаниям (SYN_*) — чтобы жюри запускало демо без ключа LLM
!data/demo/
# Готовый производный индекс материалов кейса нужен для воспроизводимого демо; исходные PDF и OCR не публикуем
*.egg-info/

# Локальные результаты модельных тестов
backend/test_results/

# Локальный кеш и журнал вызовов LLM
backend/var/
data/demo/demo_snapshot.json
