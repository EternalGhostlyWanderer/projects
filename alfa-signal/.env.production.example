# Внешний сервер (docs/deployment.md): cp .env.production.example .env и заполните значения.
# Запуск: docker compose up --build -d; HTTPS даёт Nginx на хосте (deploy/server, docs/deployment.md).

# --- Доступ ---
# Контейнеры слушают только 127.0.0.1: снаружи сайт доступен через Nginx на хосте (HTTPS).
FRONTEND_BIND=127.0.0.1
BACKEND_BIND=127.0.0.1
CORS_ORIGINS=https://signal.example.com

# --- Вход ---
VITE_DEMO_AUTH=1
VITE_LOGIN_HINT=0
# Вход обязателен для всего API, демо-учётки отключены, пароли только хешем, Swagger выключен.
AUTH_STRICT=1
# Случайная строка не короче 32 символов: openssl rand -hex 32
DEMO_AUTH_SECRET=
# Пользователи: строки из python3 backend/scripts/hash_password.py <логин> --role cfo --name "Имя",
# несколько — через «;». Формат: логин:хеш:компании через |:роль:имя
AUTH_USERS=
# Регистрация на сайте без администратора: 1 — включена, 0 — только пользователи из AUTH_USERS.
# AUTH_REGISTRATION_CODE — если задан, зарегистрироваться можно только с этим кодом приглашения.
AUTH_REGISTRATION=1
AUTH_REGISTRATION_CODE=
# Скользящая сессия: токен на N часов, продлевается, пока сайт открыт; вход не реже раза в N дней.
AUTH_SESSION_HOURS=24
AUTH_SESSION_MAX_DAYS=7

# --- Данные ---
COMPANIES_CSV=data/synthetic/companies.csv
PAYMENTS_CSV=data/synthetic/payments.csv
PEOPLE_CSV=data/synthetic/people.csv
SEED_SYNTHETIC_DATA=1
DEMO_EVENTS_FILE=data/synthetic/news.json
VITE_COMPANY_IDS=SYN_001,SYN_002,SYN_003,SYN_004,SYN_005,SYN_006
VITE_USE_DEMO=0
API_REQUIRE_COMPANY_SCOPE=1
DEMO_COMPANY_IDS=SYN_001,SYN_002,SYN_003,SYN_004,SYN_005,SYN_006

# --- Нейросеть (docs/free-llm-providers.md) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
# Запасные нейросети по порядку, если основная не ответила (модель отключили, ключ не принят, лимит, сбой):
# провайдер[:модель] через запятую. У бесплатного ключа Gemini дневной лимит свой у каждой модели:
# основная — Flash-Lite, затем другие Lite и Gemma (у каждой модели свой лимит), Groq (Qwen, gpt-oss),
# OpenRouter (бесплатная Nemotron), gemini-3.8-flash (20 запросов в сутки) и DeepSeek (платный).
# Список моделей по ключам: docker compose ... exec backend python scripts/check_llm.py --models
# Провайдер без ключа пропускается. Ключи: groq — console.groq.com/keys, openrouter — openrouter.ai/keys
# (бесплатные), deepseek — platform.deepseek.com (платный, дешёвый).
LLM_FALLBACKS=gemini:gemini-3.1-flash-lite,gemini:gemma-4-31b-it,groq:qwen/qwen3.8-27b,gemini:gemma-4-26b-a4b-it,groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,gemini:gemini-3.8-flash,deepseek
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Запросов к LLM в сутки, на которые модель ответила (отказы провайдера не считаются; сброс в 00:00 UTC).
LLM_DAILY_REQUEST_LIMIT=1000

# --- Объём анализа ---
# Сколько верхних событий ленты разбирать заранее при открытии ленты и сколько всего разборов в сутки.
PREANALYZE_ACTIVE=1
PREANALYZE_PER_COMPANY=10
PREANALYZE_DAILY_LIMIT=150
# 1 — по одному разбору: бесплатные тарифы ограничивают и число запросов в минуту.
PREANALYZE_WORKERS=1
# 0 — план агента по правилам: на один запрос к LLM меньше на каждый разбор.
AGENT_LLM_PLAN=0
# 0 — ролевой блок (акценты для бухгалтера, финдиректора) по правилам, без отдельного запроса.
ROLE_VIEW_LLM=1
# Чат: 1 — на простые вопросы не по теме (рецепт, общий факт) краткий ответ ИИ, 0 — вежливый отказ
# без запроса к модели (экономит лимит; для рабочего режима).
CHAT_OFF_TOPIC_ANSWERS=1

# --- Новости ---
NEWS_OFFICIAL_SOURCES=cbr,moex
# Иностранные издания (BBC, The Guardian, CNBC, ФРС, ЕЦБ, OilPrice, Mining.com): пусто — по умолчанию,
# «-» — выключить, или свой список через запятую. Платные (Bloomberg, FT, WSJ) — с доверием 0,95.
NEWS_RSS_URLS_FOREIGN=
NEWS_TRANSLATE_BATCHES=4
NEWS_FETCH_FULL_TEXT=1
NEWS_COLLECT_INTERVAL_MIN=30
NEWS_COLLECT_MODE=active
# Новости собираются заново при входе и при открытии ленты, если они старше N минут.
NEWS_REFRESH_ON_LOGIN_MIN=30
NEWS_REFRESH_ON_OPEN_MIN=30
