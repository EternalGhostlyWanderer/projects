# Copy this file to backend/.env and insert your provider key.
# Never commit backend/.env or paste its contents into chats.
# Provider preset: openrouter | groq | gemini | mistral | ollama | hackathon
# (free options and limits: docs/free-llm-providers.md). Ollama needs no key.
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Empty = taken from the LLM_PROVIDER preset.
# LLM_BASE_URL=
# LLM_MODEL=

# Fallbacks in order when the main model fails (disabled model, bad key, quota, outage):
# provider[:model], comma-separated; keys in <PROVIDER>_API_KEY (same provider as main — LLM_API_KEY).
# LLM_FALLBACKS=gemini:gemini-3.1-flash-lite,gemini:gemma-4-31b-it,groq:qwen/qwen3.8-27b,gemini:gemma-4-26b-a4b-it,groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,gemini:gemini-3.8-flash,deepseek
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Optional: model per role (defaults to LLM_MODEL). Hackathon gateway IDs:
# google/gemma-4-26b-a4b-it, z-ai/glm-5.3-flash, qwen/qwen3.6-35b-a3b,
# deepseek/deepseek-v4.1-flash, qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6
# LLM_MODEL_EXTRACT=google/gemma-4-26b-a4b-it
# LLM_MODEL_ANALYZE=qwen/qwen3.6-35b-a3b
# LLM_MODEL_VERIFY=z-ai/glm-5.3-flash
# LLM_MODEL_VISION=qwen/qwen3-vl-30b-a3b-instruct
# How to switch reasoning off: openrouter | effort | qwen | flat | reasoning_effort | none
# (empty = provider preset)
# LLM_THINK_STYLE=
# Budget guard for uncached requests per UTC day (0 = no limit). OpenRouter free tier: 50/day.
LLM_DAILY_REQUEST_LIMIT=45
# Optional limit on the sum of the gateway's usage.cost per day.
# LLM_DAILY_COST_LIMIT=

# --- News collection (docs/news-collection.md) ---
# RSS feeds, comma-separated. Check availability from your network; several sources = backup if one is down.
# NEWS_RSS_URLS=https://rssexport.rbc.ru/rbcnews/news/30/full.rss,https://www.interfax.ru/rss.asp,https://tass.ru/rss/v2.xml,https://www.kommersant.ru/RSS/news.xml
# Foreign English-language feeds (empty = defaults: BBC, The Guardian, CNBC, Fed, ECB, OilPrice, Mining.com;
# "-" = off). Titles and summaries are translated to Russian, up to NEWS_TRANSLATE_BATCHES LLM requests per run.
# NEWS_RSS_URLS_FOREIGN=
# NEWS_TRANSLATE_BATCHES=4
# 1 = the agent loads the full article when the feed has only an announcement.
NEWS_FETCH_FULL_TEXT=1
# Skip publications older than N days when collecting RSS (0 = keep everything).
NEWS_MAX_AGE_DAYS=7
# Collect every N minutes (0 = only by the "Обновить ленту" button / POST /api/v1/events/refresh).
NEWS_COLLECT_INTERVAL_MIN=30
# active = scheduled collection only while someone used the service in the last NEWS_ACTIVE_WINDOW_MIN minutes;
# always = regardless of activity.
NEWS_COLLECT_MODE=active
NEWS_ACTIVE_WINDOW_MIN=30
# On sign-in: refresh in background if the last collection is older than N minutes (0 = off).
NEWS_REFRESH_ON_LOGIN_MIN=30
# Opening the feed (and its 5-minute refetch from an open page): refresh if older than N minutes (0 = off).
NEWS_REFRESH_ON_OPEN_MIN=30
# A news source without new publications for N hours is reported as "stale".
NEWS_SOURCE_STALE_HOURS=48
# 1 = classify news with the LLM (paid), 0 = keywords (free).
NEWS_COLLECT_USE_LLM=0
# Pre-analyze the most important new events for these companies (comma-separated SYNTHETIC_U).
# Opening a company's feed pre-analyzes its top PREANALYZE_PER_COMPANY events in the background (paid);
# PREANALYZE_ACTIVE=0 turns it off. PREANALYZE_COMPANY_IDS are also pre-analyzed on schedule.
PREANALYZE_ACTIVE=1
# Parallel analyses (1–4).
PREANALYZE_WORKERS=2
# PREANALYZE_COMPANY_IDS=SYN_001,SYN_002
PREANALYZE_PER_COMPANY=10
PREANALYZE_MIN_SCORE=30
PREANALYZE_DAILY_LIMIT=150
# 0 = agent plan by rules (one LLM request less per analysis); 0 = role block by rules.
AGENT_LLM_PLAN=1
ROLE_VIEW_LLM=1
# Chat: 1 = brief AI answer to simple off-topic questions (demo), 0 = polite refusal without an LLM request.
CHAT_OFF_TOPIC_ANSWERS=1

# --- Sign-in on a public server (docs/deployment.md) ---
# AUTH_STRICT=1: sign-in required for the whole API, demo accounts off, hashed passwords only,
# DEMO_AUTH_SECRET of 32+ chars. Users: python3 backend/scripts/hash_password.py <login>
# AUTH_STRICT=0
# AUTH_USERS=
# Sliding session: token lifetime in hours, renewed while the site is open; re-login at least every N days.
# AUTH_SESSION_HOURS=24
# AUTH_SESSION_MAX_DAYS=7
# DEMO_AUTH_SECRET=

# --- Demo sign-in (frontend VITE_DEMO_AUTH=1) ---
# "login:password:U_1|U_2:role:Name;…" — empty company list = companies from VITE_COMPANY_IDS;
# role (owner|ceo|cfo|accountant|treasury|other, default cfo) and name are optional.
# DEMO_USERS=demo:alfa-signal::cfo:Пример Примерович;buh:alfa-signal::accountant:Ольга Бухгалтерова

# --- Access control for an external server ---
# 1 = company data only with X-Company-Id; GET /companies lists only DEMO_COMPANY_IDS.
API_REQUIRE_COMPANY_SCOPE=0
# DEMO_COMPANY_IDS=SYN_001,SYN_002
# Demo snapshot with ready analyses (scripts/export_demo.py); loaded by scripts/seed_demo.py into an empty DB.
# DEMO_SNAPSHOT_FILE=data/demo/demo_snapshot.json
